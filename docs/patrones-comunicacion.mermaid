graph TB
    subgraph REGLA_1["🔒 REGLA #1 — Bases de Datos Aisladas"]
        direction LR
        R1_NEXT["📡 Next<br/>NestJS"]
        R1_DB_NEXT[("🗄️ next_db")]
        R1_SHIFT["🔧 Shift<br/>NestJS"]
        R1_DB_SHIFT[("🗄️ shift_db")]
        R1_BLOCK["🚫 PROHIBIDO<br/>acceso cruzado"]

        R1_NEXT -->|"✅ Lee y escribe"| R1_DB_NEXT
        R1_SHIFT -->|"✅ Lee y escribe"| R1_DB_SHIFT
        R1_SHIFT -.-x|"❌ NUNCA"| R1_DB_NEXT
        R1_NEXT -.-x|"❌ NUNCA"| R1_DB_SHIFT
    end

    subgraph PATRON_1["📡 PATRÓN 1 — REST Síncrono<br/>Shift necesita datos de Next AHORA"]
        direction LR
        P1_SHIFT["🔧 Shift"]
        P1_CACHE{"🧊 Cache<br/>TTL 5min"}
        P1_NEXT["📡 Next API"]

        P1_SHIFT -->|"1. ¿Cache?"| P1_CACHE
        P1_CACHE -->|"2a. HIT → dato"| P1_SHIFT
        P1_CACHE -->|"2b. MISS"| P1_NEXT
        P1_NEXT -->|"3. Respuesta"| P1_CACHE
        P1_CACHE -->|"4. Guarda + retorna"| P1_SHIFT
    end

    subgraph PATRON_2["📤 PATRÓN 2 — Webhook / Evento<br/>Next avisa que algo cambió"]
        direction LR
        P2_NEXT["📡 Next"]
        P2_EVENT["📨 Evento<br/>vehiculo.updated<br/>operador.suspended<br/>licencia.expired"]
        P2_SHIFT["🔧 Shift"]
        P2_CACHE2["🧊 Cache"]

        P2_NEXT -->|"1. Algo cambió"| P2_EVENT
        P2_EVENT -->|"2. POST /webhooks"| P2_SHIFT
        P2_SHIFT -->|"3. Invalida"| P2_CACHE2
    end

    subgraph PATRON_3["🔌 PATRÓN 3 — WebSocket<br/>Datos en tiempo real"]
        direction LR
        P3_GPS["📟 Dispositivo<br/>GPS"]
        P3_NEXT2["📡 Next<br/>WS Gateway"]
        P3_SHIFT2["🔧 Shift"]

        P3_GPS -->|"TCP cada 10s"| P3_NEXT2
        P3_NEXT2 -->|"WS /posiciones/live"| P3_SHIFT2
    end

    subgraph JWT_FLOW["🔐 AUTENTICACIÓN — JWT Compartido"]
        direction LR
        J_USER["👤 Usuario"]
        J_NEXT["📡 Next<br/>EMITE JWT"]
        J_SHIFT["🔧 Shift<br/>VALIDA JWT"]
        J_SECRET["🔑 Misma<br/>JWT_SECRET"]

        J_USER -->|"1. Login"| J_NEXT
        J_NEXT -->|"2. Token eyJ..."| J_USER
        J_USER -->|"3. Request con token"| J_SHIFT
        J_SHIFT -->|"4. Valida firma"| J_SECRET
    end

    subgraph TURNO_TABLE["📅 REGLA #2 — Solo guardar IDs"]
        direction TB
        TT_TITLE["Tabla: Turnos en shift_db"]
        TT_FIELDS["id: 1<br/>─────────────────<br/>vehiculo_id: 12 ← solo el número<br/>operador_id: 7 ← solo el número<br/>─────────────────<br/>fecha_inicio: 2026-02-27 08:00<br/>km_inicio: 45230<br/>combustible_inicio: 75.5<br/>estatus: En curso<br/>─────────────────<br/>❌ NO guarda: placa, nombre,<br/>marca, modelo, foto, licencia<br/>✅ Esos datos se piden a Next<br/>via API cuando se necesitan"]
    end

    classDef nextBox fill:#0c1929,stroke:#38BDF8,stroke-width:1.5px,color:#BAE6FD
    classDef shiftBox fill:#1f1a08,stroke:#FBBF24,stroke-width:1.5px,color:#FEF3C7
    classDef dbBox fill:#111827,stroke:#334155,stroke-width:1px,color:#94A3B8
    classDef cacheBox fill:#052e16,stroke:#34D399,stroke-width:1px,color:#D1FAE5
    classDef eventBox fill:#1a0f2e,stroke:#A78BFA,stroke-width:1px,color:#E0D5FF
    classDef blockBox fill:#3b0000,stroke:#FB7185,stroke-width:1.5px,color:#FFC7D0
    classDef ruleBox fill:#111827,stroke:#64748B,stroke-width:1px,color:#CBD5E1
    classDef secretBox fill:#1a0f2e,stroke:#FBBF24,stroke-width:1px,color:#FBBF24

    class P1_NEXT,P2_NEXT,P3_NEXT2,R1_NEXT,J_NEXT nextBox
    class P1_SHIFT,P2_SHIFT,P3_SHIFT2,R1_SHIFT,J_SHIFT shiftBox
    class R1_DB_NEXT,R1_DB_SHIFT dbBox
    class P1_CACHE,P2_CACHE2 cacheBox
    class P2_EVENT eventBox
    class R1_BLOCK blockBox
    class TT_TITLE,TT_FIELDS,J_USER,P3_GPS ruleBox
    class J_SECRET secretBox

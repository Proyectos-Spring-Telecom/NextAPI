graph LR
    subgraph LEGEND["📌 LEYENDA"]
        direction LR
        L1["🔵 Dato propio"]
        L2["🟡 Dato propio"]
        L3["🔗 Referencia por ID"]
        L4["📡 Consulta vía API"]
    end

    subgraph NEXT_OWNS["📡 NEXT — Es dueño de estos datos<br/>🏷️ Source of Truth · Base de datos: next_db"]
        direction TB

        subgraph AUTH_DOMAIN["🔐 Dominio: Autenticación"]
            CLIENTES["👥 Clientes<br/>RFC, Nombre, Dirección<br/>TipoPersona, IdPadre"]
            USUARIOS["👤 Usuarios<br/>UserName, Password, Pin<br/>IdCliente, IdRol"]
            ROLES["🎭 Roles<br/>Admin, Supervisor, Operador"]
            PERMISOS["🔑 Permisos<br/>Por módulo y acción"]
        end

        subgraph FLEET_DOMAIN["🚐 Dominio: Flota"]
            VEHICULOS["🚐 Vehículos<br/>Placa, Económico, Marca<br/>Modelo, Año, Color, VIN<br/>Fotos, Documentos<br/>EstadoActual, Combustible"]
            OPERADORES["👷 Operadores<br/>CURP, NSS, Contacto<br/>Emergencia, Documentos<br/>IdUsuario, IdEstatus"]
            LICENCIAS["📋 Licencias<br/>NumeroLicencia, Tipo<br/>Categoría, Expedición<br/>Vencimiento, Documento"]
        end

        subgraph GPS_DOMAIN["📍 Dominio: GPS & Monitoreo"]
            DISPOSITIVOS["📟 Dispositivos<br/>IMEI, Modelo, Tipo<br/>IdSim, IdCliente"]
            SIMS["📶 SIMs<br/>ICC, IMSI, Teléfono<br/>IP, Plan, Telefonía"]
            INSTALACIONES["🔧 Instalaciones<br/>Dispositivo ↔ Vehículo<br/>Historial de cambios"]
            POSICIONES["📍 Posiciones<br/>Lat, Lng, Velocidad<br/>Rumbo, Fecha, Motor"]
        end
    end

    subgraph SHIFT_OWNS["🔧 SHIFT — Es dueño de estos datos<br/>🏷️ Consumer · Base de datos: shift_db"]
        direction TB

        subgraph TURNOS_DOMAIN["📅 Dominio: Turnos"]
            TURNOS["📅 Turnos<br/>─────────────<br/>🔗 vehiculo_id → NEXT<br/>🔗 operador_id → NEXT<br/>─────────────<br/>FechaInicio, FechaFin<br/>KmInicio, KmFin<br/>CombustibleInicio/Fin<br/>Observaciones, Estatus"]
            BITACORA["📝 BitácoraVehículo<br/>─────────────<br/>IdTurno<br/>─────────────<br/>ChecklistJSON<br/>Fotos de estado<br/>Daños encontrados<br/>NivelCombustible, KM"]
            CHECKLIST["✅ ChecklistItems<br/>Categoría, Item<br/>Estado: OK/Falla/NA<br/>Observación, Foto"]
            INCIDENCIAS["⚠️ Incidencias<br/>Tipo, Descripción<br/>Severidad, Foto<br/>Lat, Lng"]
        end

        subgraph SHIFT_CATS["📂 Catálogos Propios"]
            CAT_ESTATUS["CatEstatusTurno<br/>Programado, En curso<br/>Finalizado, Cancelado"]
            CAT_CHECK["CatItemsChecklist<br/>Puntos a evaluar"]
        end
    end

    %% ════════════════════════════════════════
    %% COMUNICACIÓN ENTRE SERVICIOS
    %% ════════════════════════════════════════

    TURNOS -.->|"📡 GET /api/v1/vehiculos/:id<br/>Valida disponibilidad"| VEHICULOS
    TURNOS -.->|"📡 GET /api/v1/operadores/:id<br/>Valida licencia vigente"| OPERADORES
    TURNOS -.->|"📡 WS /posiciones/live/:imei<br/>KM recorridos en vivo"| POSICIONES
    BITACORA -.->|"📡 GET /api/v1/vehiculos/:id<br/>Datos del vehículo para mostrar"| VEHICULOS

    %% Relaciones internas NEXT
    USUARIOS --> CLIENTES
    USUARIOS --> ROLES
    OPERADORES --> USUARIOS
    LICENCIAS --> OPERADORES
    DISPOSITIVOS --> SIMS
    INSTALACIONES --> DISPOSITIVOS
    INSTALACIONES --> VEHICULOS

    %% Relaciones internas SHIFT
    BITACORA --> TURNOS
    CHECKLIST --> BITACORA
    INCIDENCIAS --> TURNOS

    %% Estilos
    classDef nextNode fill:#0c1929,stroke:#38BDF8,stroke-width:1.5px,color:#CBD5E1
    classDef shiftNode fill:#1f1a08,stroke:#FBBF24,stroke-width:1.5px,color:#CBD5E1
    classDef catNode fill:#111827,stroke:#334155,stroke-width:1px,color:#94A3B8
    classDef legendNode fill:#111827,stroke:#334155,stroke-width:1px,color:#94A3B8

    class CLIENTES,USUARIOS,ROLES,PERMISOS,VEHICULOS,OPERADORES,LICENCIAS,DISPOSITIVOS,SIMS,INSTALACIONES,POSICIONES nextNode
    class TURNOS,BITACORA,CHECKLIST,INCIDENCIAS shiftNode
    class CAT_ESTATUS,CAT_CHECK catNode
    class L1,L2,L3,L4 legendNode

erDiagram
    %% ════════════════════════════════════════
    %% SHIFT_DB — Entidad Relación
    %% Solo IDs como referencia a Next (sin FK real)
    %% ════════════════════════════════════════

    Turnos {
        bigint id PK
        bigint idCliente "Ref logica → Next.Clientes"
        bigint vehiculoId "Ref logica → Next.Vehiculos"
        bigint operadorId "Ref logica → Next.Operadores"
        tinyint idEstatusTurno FK
        datetime fechaInicio
        datetime fechaFin "NULL si activo"
        float kmInicio
        float kmFin "NULL si activo"
        float combustibleInicio
        float combustibleFin "NULL si activo"
        text observaciones
        tinyint estatus "1=Activo 0=Eliminado"
        datetime fechaCreacion
        datetime fechaActualizacion
    }

    BitacoraVehiculo {
        bigint id PK
        bigint idTurno FK
        bigint vehiculoId "Ref logica → Next.Vehiculos"
        bigint idCliente "Ref logica → Next.Clientes"
        tinyint tipo "1=CheckIn 2=CheckOut"
        float kmActual
        float nivelCombustible
        varchar fotoDerecha "URL S3"
        varchar fotoIzquierda "URL S3"
        varchar fotoFrente "URL S3"
        varchar fotoTrasera "URL S3"
        varchar fotoTablero "URL S3 - odómetro"
        text observacionesGenerales
        datetime fechaRegistro
        tinyint estatus
    }

    ChecklistItems {
        bigint id PK
        bigint idBitacora FK
        bigint idCatItem FK
        tinyint estado "1=OK 2=Falla 3=NA"
        varchar observacion
        varchar fotoEvidencia "URL S3 si hay falla"
    }

    IncidenciasTurno {
        bigint id PK
        bigint idTurno FK
        bigint idCliente "Ref logica → Next.Clientes"
        varchar tipo "Mecanica Accidente Multa"
        varchar descripcion
        tinyint severidad "1=Baja 2=Media 3=Alta"
        varchar fotoEvidencia "URL S3"
        decimal latitud
        decimal longitud
        datetime fechaRegistro
        tinyint estatus
    }

    CatEstatusTurno {
        tinyint id PK
        varchar nombre "Programado EnCurso Fin Cancel"
    }

    CatItemsChecklist {
        bigint id PK
        varchar categoria "Exterior Interior Mecanico"
        varchar nombre "Llantas Espejos Frenos Luces"
        int orden
        tinyint estatus
    }

    %% ════════════════════════════════════════
    %% RELACIONES
    %% ════════════════════════════════════════

    Turnos ||--o{ BitacoraVehiculo : "tiene check-in y check-out"
    Turnos ||--o{ IncidenciasTurno : "puede tener incidencias"
    Turnos }o--|| CatEstatusTurno : "tiene un estatus"
    BitacoraVehiculo ||--o{ ChecklistItems : "contiene items evaluados"
    ChecklistItems }o--|| CatItemsChecklist : "referencia al catálogo"
